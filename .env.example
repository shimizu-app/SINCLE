# Supabase（ダッシュボード → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# メールのリンク先・OAuth のコールバック先に使う本番URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 型の再生成に使う（ダッシュボード → Account → Access Tokens）
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx

# ログインコードの桁数。Supabase の mailer_otp_length と必ず揃えること
# （Supabase の既定は 8。setup:auth は 6 に設定します）
NEXT_PUBLIC_OTP_LENGTH=6

# ── 名刺の読み取り（フェーズ4）──────────────────────────────
# Google Cloud のサービスアカウント（Vision を呼ぶ用）の JSON。
# そのまま貼ってもよいが、1行で収まる base64 のほうが事故が少ない。
#
#   base64 -w0 nico-app-xxxxxx.json     # Linux
#   base64 -i  nico-app-xxxxxx.json     # macOS
#
# NEXT_PUBLIC_ を付けてはいけない（ブラウザに焼き込まれる）。
# 入っていなければ、スキャン画面は手入力へ案内するだけで落ちない。
# GOOGLE_VISION_SA_KEY=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCiAgLi4uCn0=

# どちらか片方でよい。上のJSONを扱うのが手間なら、こちらのAPIキーを使う。
# Google Cloud → APIとサービス → 認証情報 → 認証情報を作成 → APIキー。
# 作ったら「APIの制限」で Cloud Vision API だけに絞ること（漏れたときの被害を抑える）。
# GOOGLE_VISION_API_KEY=AIzaSy...

# ── Google 連携（フェーズ6）────────────────────────────────
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
